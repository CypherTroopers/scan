APPLICATION_MODE=all
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_HTTP_URL=https://test2.make-cph-great-again.community
ETHEREUM_JSONRPC_TRACE_URL=https://test2.make-cph-great-again.community
ETHEREUM_JSONRPC_ETH_CALL_URL=https://test2.make-cph-great-again.community
ETHEREUM_JSONRPC_GETH_TRACE_BY_BLOCK=true
ETHEREUM_JSONRPC_HTTP_BATCH_SIZE=20
CHAIN_ID=10101919
NETWORK=ColossusX
SUBNETWORK=ColossusX
COIN=CLX
COIN_NAME=colossusX
BLOCKSCOUT_PROTOCOL=http
PORT=4000
ECTO_SSL_MODE=disable
ECTO_USE_SSL=false
POOL_SIZE=30
POOL_SIZE_API=10
DISABLE_FILE_LOGGING=true
DISABLE_MARKET=true
ACCOUNT_ENABLED=false
# Keep API totals fresh even after the chain exceeds the small-chain cache thresholds.
CACHE_BLOCK_COUNT_PERIOD=30s
CACHE_TXS_COUNT_PERIOD=30s
API_V2_ENABLED=true
API_RATE_LIMIT_HAMMER_REDIS_URL=redis://redis:6379/1
ACCOUNT_REDIS_URL=redis://redis:6379/0
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=10
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=1
# Keep the v10 indexer memory monitor below the 3 GiB container limit.
INDEXER_MEMORY_LIMIT=2g
INDEXER_INTERNAL_TRANSACTIONS_BATCH_SIZE=5
INDEXER_INTERNAL_TRANSACTIONS_CONCURRENCY=1
INDEXER_COIN_BALANCES_CONCURRENCY=1
INDEXER_RECEIPTS_CONCURRENCY=1
# Cypherium rewards must not be inferred from Ethereum PoW emission rules.
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=false
# This network has no Ethereum Beacon API or staking deposit contract.
INDEXER_DISABLE_BEACON_BLOB_FETCHER=true
INDEXER_DISABLE_BEACON_DEPOSIT_FETCHER=true
INDEXER_DISABLE_BEACON_DEPOSIT_STATUS_FETCHER=true
ERL_FLAGS=+S 2:2

# ColossusX FHS-D rewards: verify network identity before importing payouts.
FETCH_REWARDS_WAY=colossusx
COLOSSUSX_REWARDS_GENESIS_HASH=0xe69022ef43f6d238846015e0a4e7cdd190cf45e9fd98cfa0666acb482a05017e
