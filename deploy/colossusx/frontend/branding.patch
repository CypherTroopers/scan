@@ -0,0 +1,32 @@
+// Modified for ColossusX on 2026-09-21; see COLOSSUSX_CHANGES.md.
+
+import type { ColossusxBlockRewards, ColossusxRewardCategory } from 'types/api/block';
+
+const categories: Array<{
+  category: ColossusxRewardCategory;
+  label: string;
+  field: 'block_reward' | 'common_miner_reward' | 'common_rpc_reward';
+}> = [
+  { category: 'block', label: 'Block production', field: 'block_reward' },
+  { category: 'common_miner', label: 'Common miner PoW', field: 'common_miner_reward' },
+  { category: 'common_rpc', label: 'Common RPC', field: 'common_rpc_reward' },
+];
+
+const isWeiAmount = (value: string | null): value is string => typeof value === 'string' && /^\d+$/.test(value);
+
+export default function getColossusxRewards(rewards: ColossusxBlockRewards) {
+  const isComplete = rewards.status === 'complete' && isWeiAmount(rewards.total) &&
+    categories.every(({ field }) => isWeiAmount(rewards[field])) &&
+    rewards.payouts.every(({ reward }) => isWeiAmount(reward));
+
+  return {
+    isComplete,
+    total: isComplete ? rewards.total : null,
+    categories: categories.map(({ category, label, field }) => ({
+      category,
+      label,
+      amount: isComplete ? rewards[field] : null,
+      payouts: isComplete ? rewards.payouts.filter(payout => payout.category === category) : [],
+    })),
+  };
+}
