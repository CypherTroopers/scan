@@ -0,0 +1,42 @@
+// Modified for ColossusX on 2026-09-21; see COLOSSUSX_CHANGES.md.
+
+import type { LineChart } from '@blockscout/stats-types';
+import type { TimeChartItem } from 'toolkit/components/charts/types';
+
+export const UTC_DAY_MS = 24 * 60 * 60 * 1000;
+
+export function getDailyTransactionsRange(now = new Date()) {
+  const to = now.toISOString().slice(0, 10);
+  const midnight = new Date(`${ to }T00:00:00.000Z`).getTime();
+
+  return {
+    from: new Date(midnight - 29 * UTC_DAY_MS).toISOString().slice(0, 10),
+    to,
+    nextMidnight: midnight + UTC_DAY_MS,
+  };
+}
+
+export function getDailyTransactionsData(chart: LineChart['chart'], today: string) {
+  const items: Array<TimeChartItem> = chart.flatMap((item) => {
+    if (item.value === null || item.value === undefined || item.value === '') {
+      return [];
+    }
+
+    const value = Number(item.value);
+    if (!Number.isFinite(value)) {
+      return [];
+    }
+
+    return [ {
+      date: new Date(item.date),
+      date_to: item.date_to ? new Date(item.date_to) : undefined,
+      dateLabel: `${ item.date } (UTC)`,
+      value,
+      isApproximate: item.is_approximate || item.date === today,
+    } ];
+  });
+  const todayTime = new Date(`${ today }T00:00:00.000Z`).getTime();
+  const todayValue = items.find((item) => item.date.getTime() === todayTime)?.value;
+
+  return { items, todayValue };
+}
