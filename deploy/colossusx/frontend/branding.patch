@@ -0,0 +1,51 @@
+// Modified for ColossusX on 2026-09-21; see COLOSSUSX_CHANGES.md.
+
+import { Box, Flex, Text } from '@chakra-ui/react';
+import React from 'react';
+
+import type { ColossusxBlockRewards } from 'types/api/block';
+
+import getColossusxRewards from 'lib/block/getColossusxRewards';
+import AddressEntity from 'ui/shared/entities/address/AddressEntity';
+import NativeCoinValue from 'ui/shared/value/NativeCoinValue';
+
+interface Props {
+  rewards: ColossusxBlockRewards;
+  showTotal?: boolean;
+  compact?: boolean;
+}
+
+const ColossusxRewardBreakdown = ({ rewards, showTotal = false, compact = false }: Props) => {
+  const { isComplete, total, categories } = getColossusxRewards(rewards);
+
+  if (!isComplete) {
+    return <Text color="text.secondary">Pending reward indexing</Text>;
+  }
+
+  return (
+    <Box minW={ 0 } maxW="100%" maxH={ compact ? '360px' : undefined } overflowY={ compact ? 'auto' : undefined } whiteSpace="normal">
+      { showTotal && (
+        <Flex gap={ 2 } flexWrap="wrap" mb={ 3 }>
+          <Text fontWeight={ 600 }>Total reward</Text>
+          <NativeCoinValue amount={ total } accuracy={ 0 } noTooltip/>
+        </Flex>
+      ) }
+      { categories.map(({ category, label, amount, payouts }) => (
+        <Box key={ category } mb={ 3 } _last={{ mb: 0 }}>
+          <Flex gap={ 2 } flexWrap="wrap" alignItems="center">
+            <Text fontWeight={ 500 }>{ label }</Text>
+            <NativeCoinValue amount={ amount } accuracy={ 0 } noTooltip/>
+          </Flex>
+          { payouts.map(({ address_hash: addressHash, reward }, index) => (
+            <Flex key={ `${ addressHash }-${ index }` } mt={ 1 } gap={ 2 } flexWrap="wrap" alignItems="center" minW={ 0 }>
+              <AddressEntity address={{ hash: addressHash }} truncation="constant" noIcon noCopy noTooltip/>
+              <NativeCoinValue amount={ reward } accuracy={ 0 } noTooltip color="text.secondary"/>
+            </Flex>
+          )) }
+        </Box>
+      )) }
+    </Box>
+  );
+};
+
+export default React.memo(ColossusxRewardBreakdown);
