+}));
+
+vi.mock('lib/api/useApiQuery', () => ({
+  'default': vi.fn(() => ({
+    data: { chart: [] },
+    isPending: false,
+    isError: false,
+  })),
+}));
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date('2026-09-20T23:59:59.500Z'));
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+test('advances the API date key and range exactly at UTC midnight', () => {
+  const { unmount } = renderHook(() => useDailyTransactions());
+  expect(useApiQuery).toHaveBeenLastCalledWith('stats:line', expect.objectContaining({
+    queryParams: { resolution: 'DAY', from: '2026-08-22', to: '2026-09-20' },
+  }));
+
+  act(() => vi.advanceTimersByTime(500));
+
+  expect(useApiQuery).toHaveBeenLastCalledWith('stats:line', expect.objectContaining({
+    queryParams: { resolution: 'DAY', from: '2026-08-23', to: '2026-09-21' },
+  }));
+  unmount();
+});
+
+test('corrects the date key on return after browser timers were suspended', () => {
+  const { unmount } = renderHook(() => useDailyTransactions());
+  vi.setSystemTime(new Date('2026-09-23T03:00:00.000Z'));
+
+  act(() => window.dispatchEvent(new Event('focus')));
+
+  expect(useApiQuery).toHaveBeenLastCalledWith('stats:line', expect.objectContaining({
+    queryParams: { resolution: 'DAY', from: '2026-08-25', to: '2026-09-23' },
+  }));
+  unmount();
+});
+
+test('corrects the UTC range when a suspended tab becomes visible', () => {
+  const { unmount } = renderHook(() => useDailyTransactions());
+  vi.setSystemTime(new Date('2026-09-24T02:00:00.000Z'));
