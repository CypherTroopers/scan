+// Modified for ColossusX on 2026-09-21; see COLOSSUSX_CHANGES.md.
+
+import type { Block, ColossusxBlockRewards } from 'types/api/block';
+
+import { base } from 'mocks/blocks/block';
+import { expect, test, vi } from 'vitest';
+
+import getBlockReward from './getBlockReward';
+import getBlockTotalReward from './getBlockTotalReward';
+import getColossusxRewards from './getColossusxRewards';
+import hasPendingColossusxRewards from './hasPendingColossusxRewards';
+
+vi.mock('configs/app', () => ({
+  'default': { chain: { currency: { decimals: 18, symbol: 'CLX' } } },
+}));
+
+const miner = '0x1111111111111111111111111111111111111111';
+const otherMiner = '0x2222222222222222222222222222222222222222';
+const rpc = '0x3333333333333333333333333333333333333333';
+
+const complete: ColossusxBlockRewards = {
+  status: 'complete',
+  rule_version: 'FHS-D/64c12623',
+  total: '6000000000000000007',
+  block_reward: '2000000000000000001',
+  common_miner_reward: '3000000000000000004',
+  common_rpc_reward: '1000000000000000002',
+  payouts: [
+    { address_hash: miner, category: 'block', reward: '2000000000000000001' },
+    { address_hash: miner, category: 'common_miner', reward: '1000000000000000001' },
+    { address_hash: otherMiner, category: 'common_miner', reward: '2000000000000000003' },
+    { address_hash: rpc, category: 'common_rpc', reward: '1000000000000000002' },
+  ],
+};
+
+const block = (rewards: ColossusxBlockRewards | undefined = complete): Block => ({
+  ...base,
+  // These intentionally disagree with the native rewards. Never add them again.
+  transaction_fees: '99000000000000000000',
+  burnt_fees: '11000000000000000000',
+  rewards: [ { type: 'Miner Reward', reward: '800000000000000000000' } ],
+  colossusx_rewards: rewards,
+});
+
+test('keeps every wei beyond JavaScript integer precision in list and detail totals', () => {
+  expect(getBlockTotalReward(block())?.toFixed()).toBe('6.000000000000000007');
+  expect(getBlockReward(block()).totalReward?.toFixed()).toBe(complete.total);
+
+  const veryLarge = block({ ...complete, total: '123456789012345678901234567890123456789' });
+  expect(getBlockTotalReward(veryLarge)?.toFixed()).toBe('123456789012345678901.234567890123456789');
+});
+
+test('uses native category amounts directly and never adds fees, burns or legacy rewards', () => {
+  const reward = getBlockReward(block());
+  expect(reward.totalReward?.toFixed()).toBe(complete.total);
+  expect(reward.staticReward?.toFixed()).toBe(complete.block_reward);
+  expect(reward.txFees.toFixed()).toBe('99000000000000000000');
+  expect(reward.burntFees.toFixed()).toBe('11000000000000000000');
+
+  const differentFees = { ...block(), transaction_fees: '1', burnt_fees: '0' };
+  expect(getBlockReward(differentFees).totalReward?.toFixed()).toBe(complete.total);
+  expect(getBlockTotalReward(differentFees)?.toFixed()).toBe('6.000000000000000007');
+});
+
+test('retains verified zero rather than treating it as missing or falling back to legacy rewards', () => {
+  const zero: ColossusxBlockRewards = {
+    ...complete, total: '0', block_reward: '0', common_miner_reward: '0', common_rpc_reward: '0', payouts: [],
+  };
+  expect(getBlockTotalReward(block(zero))?.toFixed()).toBe('0');
+  expect(getBlockReward(block(zero)).totalReward?.toFixed()).toBe('0');
+  expect(getColossusxRewards(zero).categories.map(({ amount }) => amount)).toEqual([ '0', '0', '0' ]);
+  expect(hasPendingColossusxRewards(block(zero))).toBe(false);
+});
+
+test('keeps pending separate from zero even when stale legacy or partial native amounts exist', () => {
+  const pending = { ...complete, status: 'pending' as const };
+  expect(getBlockTotalReward(block(pending))).toBeNull();
+  expect(getBlockReward(block(pending)).totalReward).toBeNull();
+  expect(getBlockReward(block(pending)).staticReward).toBeNull();
+  expect(getColossusxRewards(pending).categories.every(({ amount, payouts }) => amount === null && payouts.length === 0)).toBe(true);
+  expect(hasPendingColossusxRewards(block(pending))).toBe(true);
+});
+
+test.each([ null, '', 'NaN', '-1', '0.5', '1e18' ])('never renders an incomplete or invalid wei amount %s as zero', (total) => {
+  const invalid = block({ ...complete, total });
+  expect(getBlockTotalReward(invalid)).toBeNull();
+  expect(getBlockReward(invalid).totalReward).toBeNull();
+  expect(hasPendingColossusxRewards(invalid)).toBe(true);
+});
+
+test('preserves multiple recipients and payouts to the same address in separate categories', () => {
+  const snapshot = JSON.stringify(complete);
+  const view = getColossusxRewards(complete);
+  expect(view.categories.map(({ label }) => label)).toEqual([ 'Block production', 'Common miner PoW', 'Common RPC' ]);
+  expect(view.categories[0].payouts.map(({ address_hash: hash }) => hash)).toEqual([ miner ]);
+  expect(view.categories[1].payouts.map(({ address_hash: hash }) => hash)).toEqual([ miner, otherMiner ]);
+  expect(view.categories[1].payouts.map(({ reward }) => reward)).toEqual([ '1000000000000000001', '2000000000000000003' ]);
+  expect(view.categories[2].payouts[0].address_hash).toBe(rpc);
+  expect(getBlockTotalReward(block())?.toFixed()).toBe('6.000000000000000007');
+  expect(JSON.stringify(complete)).toBe(snapshot);
+});
+
+test('keeps original Ethereum behavior when the custom API extension is absent', () => {
+  const legacy = { ...block(), colossusx_rewards: undefined };
+  expect(getBlockTotalReward(legacy)?.toFixed()).toBe('800');
+  expect(getBlockReward(legacy).totalReward?.toFixed()).toBe('800000000000000000000');
+  expect(getBlockReward(legacy).staticReward?.toFixed()).toBe('712000000000000000000');
+  expect(hasPendingColossusxRewards(legacy)).toBe(false);
+  expect(hasPendingColossusxRewards(undefined)).toBe(false);
+});
+
+test('stops pending refresh once the same block has a verified reward', () => {
+  const pending = block({ ...complete, status: 'pending', total: null, payouts: [] });
+  expect(hasPendingColossusxRewards(pending)).toBe(true);
+  expect(hasPendingColossusxRewards({ ...pending, colossusx_rewards: complete })).toBe(false);
+});
