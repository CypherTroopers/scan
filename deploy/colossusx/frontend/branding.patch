+// Modified for ColossusX on 2026-09-21; see COLOSSUSX_CHANGES.md.
+
+import React from 'react';
+
+import type { Block } from 'types/api/block';
+
+import getBlockTotalReward from 'lib/block/getBlockTotalReward';
+import { Skeleton } from 'toolkit/chakra/skeleton';
+import { Tooltip } from 'toolkit/chakra/tooltip';
+import type { Props as SimpleValueProps } from 'ui/shared/value/SimpleValue';
+import SimpleValue from 'ui/shared/value/SimpleValue';
+
+import ColossusxRewardBreakdown from './ColossusxRewardBreakdown';
+
+interface Props extends Pick<SimpleValueProps, 'loading' | 'color' | 'endElement' | 'accuracy'> {
+  block: Block;
+}
+
+const BlockRewardValue = ({ block, loading, color, endElement, accuracy }: Props) => {
+  const totalReward = getBlockTotalReward(block);
+
+  if (totalReward === null) {
+    return (
+      <Skeleton loading={ loading } color={ color }>
+        <Tooltip content="Reward indexing is pending. The reward amount is not yet available.">
+          <span>Pending</span>
+        </Tooltip>
+      </Skeleton>
+    );
+  }
+
+  return (
+    <SimpleValue
+      value={ totalReward }
+      loading={ loading }
+      color={ color }
+      endElement={ endElement }
+      accuracy={ accuracy }
+      tooltipContent={ block.colossusx_rewards ? <ColossusxRewardBreakdown rewards={ block.colossusx_rewards } showTotal compact/> : undefined }
+    />
+  );
+};
+
+export default React.memo(BlockRewardValue);
