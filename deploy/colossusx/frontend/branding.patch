+// Modified for ColossusX on 2026-09-21; see COLOSSUSX_CHANGES.md.
+
+import type { LineChart } from '@blockscout/stats-types';
+
+import { expect, test } from 'vitest';
+
+import { getDailyTransactionsData, getDailyTransactionsRange } from './dailyTransactions';
+
+const point = (date: string, value: string, isApproximate = false): LineChart['chart'][number] => ({
+  date,
+  date_to: date,
+  value,
+  is_approximate: isApproximate,
+});
+
+test.each([
+  [ '2026-09-20T23:59:59.999Z', '2026-08-22', '2026-09-20' ],
+  [ '2026-09-21T00:00:00.000Z', '2026-08-23', '2026-09-21' ],
+  [ '2026-09-20T20:00:00-07:00', '2026-08-23', '2026-09-21' ],
+  [ '2024-03-01T00:00:00.000Z', '2024-02-01', '2024-03-01' ],
+])('keeps a 30-day inclusive UTC range for %s', (now, from, to) => {
+  const range = getDailyTransactionsRange(new Date(now));
+  expect(range).toMatchObject({ from, to });
+  expect(new Date(range.nextMidnight).toISOString()).toMatch(/T00:00:00.000Z$/);
+  expect(range.nextMidnight).toBeGreaterThan(new Date(now).getTime());
+});
+
+test('uses the current UTC point for both the headline and chart, including real zero', () => {
+  const { items, todayValue } = getDailyTransactionsData([
+    point('2026-09-19', '506'),
+    point('2026-09-20', '0'),
+  ], '2026-09-20');
+
+  expect(todayValue).toBe(0);
+  expect(items[1]).toMatchObject({ value: todayValue, dateLabel: '2026-09-20 (UTC)', isApproximate: true });
+  expect(items[1].date.toISOString()).toBe('2026-09-20T00:00:00.000Z');
+  expect(items[1].date_to?.toISOString()).toBe('2026-09-20T00:00:00.000Z');
+});
+
+test('does not substitute yesterday when the current day is missing', () => {
+  const data = getDailyTransactionsData([ point('2026-09-19', '506', true) ], '2026-09-20');
+  expect(data.todayValue).toBeUndefined();
+  expect(data.items).toHaveLength(1);
+  expect(data.items[0].isApproximate).toBe(true);
+});
+
+test.each([ '', 'NaN' ])('treats an unusable current-day value %s as missing', (value) => {
+  const data = getDailyTransactionsData([ point('2026-09-20', value) ], '2026-09-20');
+  expect(data.todayValue).toBeUndefined();
+  expect(data.items).toHaveLength(0);
+});
