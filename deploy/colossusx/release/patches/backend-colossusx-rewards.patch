+# Modified for ColossusX on 2026-09-21. SPDX-License-Identifier: GPL-3.0-only
+defmodule BlockScoutWeb.Schemas.API.V2.ColossusXRewardsTest do
+  use ExUnit.Case, async: true
+
+  alias BlockScoutWeb.Schemas.API.V2.Block.ColossusXRewards, as: RewardSchema
+  alias Explorer.Chain.Block.ColossusXRewards
+
+  test "pending summary satisfies the documented schema" do
+    value = ColossusXRewards.summary([]) |> Jason.encode!() |> Jason.decode!()
+    assert {:ok, _} = OpenApiSpex.cast_value(value, RewardSchema.schema())
+  end
+
+  test "complete schema accepts precise integer wei and rejects floats and missing fields" do
+    value = %{
+      "status" => "complete",
+      "rule_version" => "FHS-D/64c12623",
+      "total" => "100000000004200000000001",
+      "block_reward" => "100000000000000000000000",
+      "common_miner_reward" => "0",
+      "common_rpc_reward" => "4200000000001",
+      "payouts" => [
+        %{
+          "address_hash" => "0x1111111111111111111111111111111111111111",
+          "category" => "common_rpc",
+          "reward" => "4200000000001"
+        }
+      ]
+    }
+
+    assert {:ok, _} = OpenApiSpex.cast_value(value, RewardSchema.schema())
+    assert {:error, _} = OpenApiSpex.cast_value(Map.put(value, "total", "1.1"), RewardSchema.schema())
+    assert {:error, _} = OpenApiSpex.cast_value(Map.delete(value, "payouts"), RewardSchema.schema())
+  end
+end
