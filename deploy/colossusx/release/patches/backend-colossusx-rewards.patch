+# Modified for ColossusX on 2026-09-21. SPDX-License-Identifier: GPL-3.0-only
+defmodule Indexer.ColossusXSupervisorTest do
+  use ExUnit.Case, async: false
+
+  alias Indexer.Fetcher.BlockReward.Supervisor, as: RewardSupervisor
+
+  setup do
+    keys = [
+      :fetch_rewards_way,
+      :json_rpc_named_arguments,
+      :block_interval,
+      :subscribe_named_arguments,
+      RewardSupervisor
+    ]
+
+    previous = Map.new(keys, &{&1, Application.fetch_env(:indexer, &1)})
+    Application.put_env(:indexer, RewardSupervisor, disabled?: false)
+    Application.put_env(:indexer, :block_interval, 500)
+    Application.put_env(:indexer, :subscribe_named_arguments, [])
+
+    on_exit(fn ->
+      Enum.each(previous, fn
+        {key, {:ok, value}} -> Application.put_env(:indexer, key, value)
+        {key, :error} -> Application.delete_env(:indexer, key)
+      end)
+    end)
+
+    :ok
+  end
+
+  test "ColossusX starts reward backfill with the Geth tracing variant" do
+    children = children("colossusx", EthereumJSONRPC.Geth)
+    assert Enum.any?(children, &(&1.id == RewardSupervisor))
+    refute RewardSupervisor.disabled?()
+  end
+
+  test "default Geth mode retains upstream unsupported-reward behavior" do
+    children = children("trace_block", EthereumJSONRPC.Geth)
+    refute Enum.any?(children, &(&1.id == RewardSupervisor))
+    assert RewardSupervisor.disabled?()
+  end
+
+  test "supported upstream variants still include reward backfill" do
+    children = children("trace_block", EthereumJSONRPC.Nethermind)
+    assert Enum.any?(children, &(&1.id == RewardSupervisor))
+    refute RewardSupervisor.disabled?()
+  end
+
+  test "the operator can explicitly disable custom reward backfill" do
+    Application.put_env(:indexer, RewardSupervisor, disabled?: true)
+    children("colossusx", EthereumJSONRPC.Geth)
+    assert RewardSupervisor.disabled?()
+  end
+
+  defp children(mode, variant) do
+    Application.put_env(:indexer, :fetch_rewards_way, mode)
+    arguments = Application.fetch_env!(:indexer, :json_rpc_named_arguments)
+    Application.put_env(:indexer, :json_rpc_named_arguments, Keyword.put(arguments, :variant, variant))
+    {:ok, {_flags, children}} = Indexer.Supervisor.init(%{memory_monitor: nil})
+    children
+  end
+end
