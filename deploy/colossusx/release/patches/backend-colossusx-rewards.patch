+# Modified for ColossusX on 2026-09-21. SPDX-License-Identifier: GPL-3.0-only
+defmodule Explorer.Chain.Block.ColossusXRewardsTest do
+  use ExUnit.Case, async: true
+
+  alias Explorer.Chain.{Hash, Wei}
+  alias Explorer.Chain.Block.{ColossusXRewards, Reward}
+  alias Explorer.Chain.Block.Reward.AddressType
+
+  @creator "0x1111111111111111111111111111111111111111"
+  @recipient "0x2222222222222222222222222222222222222222"
+  @subsidy 100_000_000_000_000_000_000_000
+
+  test "missing or partial reward data remains pending" do
+    for rows <- [[], nil, [reward(:colossusx_rpc, @recipient, 4_200_000_000_000)]] do
+      assert %{status: "pending", total: nil, block_reward: nil, payouts: []} = ColossusXRewards.summary(rows)
+    end
+  end
+
+  test "an explicit zero marker distinguishes a rewardless block" do
+    result = ColossusXRewards.summary([reward(:validator, @creator, 0)])
+    assert result.status == "complete"
+    assert result.total == "0"
+    assert result.block_reward == "0"
+    assert result.common_miner_reward == "0"
+    assert result.common_rpc_reward == "0"
+    assert result.payouts == []
+  end
+
+  test "all payout categories preserve exact wei and their separate recipients" do
+    rows = [
+      reward(:validator, @creator, @subsidy),
+      reward(:colossusx_pow, @recipient, @subsidy),
+      reward(:colossusx_rpc, @recipient, 4_200_000_000_001),
+      reward(:colossusx_rpc, @creator, 1)
+    ]
+
+    result = ColossusXRewards.summary(rows)
+    assert result.total == "200000000004200000000002"
+    assert result.block_reward == Integer.to_string(@subsidy)
+    assert result.common_miner_reward == Integer.to_string(@subsidy)
+    assert result.common_rpc_reward == "4200000000002"
+    assert length(result.payouts) == 4
+    assert %{address_hash: @recipient, category: "common_miner", reward: Integer.to_string(@subsidy)} in result.payouts
+    assert Hash.to_string(ColossusXRewards.block_beneficiary(rows, nil)) == @creator
+  end
+
+  test "totals remain exact beyond the default Decimal arithmetic precision" do
+    large = 100_000_000_000_000_000_000_000_000_000_000_000_000
+
+    result =
+      ColossusXRewards.summary([reward(:validator, @creator, @subsidy), reward(:colossusx_rpc, @recipient, large + 1)])
+
+    assert result.total == Integer.to_string(large + 1 + @subsidy)
+    assert result.common_rpc_reward == Integer.to_string(large + 1)
+  end
+
+  test "an unsupported legacy reward does not masquerade as verified FHS-D data" do
+    result = ColossusXRewards.summary([reward(:validator, @creator, @subsidy), reward(:uncle, @recipient, 1)])
+    assert result.status == "pending"
+  end
+
+  test "custom address types round-trip through the database representation" do
+    for type <- [:colossusx_pow, :colossusx_rpc] do
+      assert {:ok, ^type} = AddressType.cast(type)
+      assert {:ok, value} = AddressType.dump(type)
+      assert {:ok, ^type} = AddressType.cast(value)
+      assert {:ok, ^type} = AddressType.load(value)
+    end
+
+    assert :error = AddressType.cast("unknown_reward_type")
+  end
+
+  defp reward(type, address, amount) do
+    {:ok, address_hash} = Hash.Address.cast(address)
+    %Reward{address_type: type, address_hash: address_hash, reward: %Wei{value: Decimal.new(amount)}}
+  end
+end
