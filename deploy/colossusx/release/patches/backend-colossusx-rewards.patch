@@ -0,0 +1,86 @@
+# Modified for ColossusX on 2026-09-21. SPDX-License-Identifier: GPL-3.0-only
+defmodule Explorer.Chain.Block.ColossusXRewards do
+  @moduledoc """
+  Presents indexed FHS-D payouts without applying Ethereum fee arithmetic.
+
+  A validator row, including an explicit zero, marks a completely verified block.
+  The fetcher imports this row and all additional payouts atomically. Missing
+  rows are pending, never evidence that the protocol paid zero.
+  """
+
+  alias Explorer.Chain.{Hash, Wei}
+
+  @categories %{validator: "block", colossusx_pow: "common_miner", colossusx_rpc: "common_rpc"}
+  @rule_version "FHS-D/64c12623"
+
+  def enabled?, do: Application.get_env(:indexer, :fetch_rewards_way) == "colossusx"
+
+  def summary(rewards) do
+    if complete?(rewards) do
+      complete_summary(rewards)
+    else
+      %{
+        status: "pending",
+        rule_version: @rule_version,
+        total: nil,
+        block_reward: nil,
+        common_miner_reward: nil,
+        common_rpc_reward: nil,
+        payouts: []
+      }
+    end
+  end
+
+  def block_beneficiary(rewards, fallback) when is_list(rewards) do
+    case Enum.find(rewards, &(&1.address_type == :validator)) do
+      nil -> fallback
+      reward -> reward.address_hash
+    end
+  end
+
+  def block_beneficiary(_, fallback), do: fallback
+
+  defp complete?(rewards) when is_list(rewards) do
+    Enum.any?(rewards, &(&1.address_type == :validator)) and
+      Enum.all?(rewards, fn reward ->
+        Map.has_key?(@categories, reward.address_type) and
+          Decimal.compare(Wei.to(reward.reward, :wei), 0) != :lt
+      end)
+  end
+
+  defp complete?(_), do: false
+
+  defp complete_summary(rewards) do
+    payouts =
+      rewards
+      |> Enum.reject(&(Decimal.compare(Wei.to(&1.reward, :wei), 0) == :eq))
+      |> Enum.map(fn reward ->
+        %{
+          address_hash: Hash.to_string(reward.address_hash),
+          category: Map.fetch!(@categories, reward.address_type),
+          reward: amount(reward.reward)
+        }
+      end)
+      |> Enum.sort_by(&{&1.category, &1.address_hash})
+
+    %{
+      status: "complete",
+      rule_version: @rule_version,
+      total: sum(rewards),
+      block_reward: sum_type(rewards, :validator),
+      common_miner_reward: sum_type(rewards, :colossusx_pow),
+      common_rpc_reward: sum_type(rewards, :colossusx_rpc),
+      payouts: payouts
+    }
+  end
+
+  defp amount(value), do: value |> Wei.to(:wei) |> Decimal.to_string(:normal)
+
+  defp sum_type(rewards, type), do: rewards |> Enum.filter(&(&1.address_type == type)) |> sum()
+
+  defp sum(rewards) do
+    rewards
+    |> Enum.reduce(0, &(Decimal.to_integer(Wei.to(&1.reward, :wei)) + &2))
+    |> Integer.to_string()
+  end
+end
