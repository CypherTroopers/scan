+defmodule BlockScoutWeb.Schemas.API.V2.Block.ColossusXRewards do
+  @moduledoc """
+  Exact FHS-D rewards in integer wei. Present only when ColossusX indexing is enabled.
+  Pending amounts are null; a verified rewardless block has decimal-string zeroes.
+  """
+  require OpenApiSpex
+  alias OpenApiSpex.Schema
+
+  @amount %Schema{type: :string, pattern: "^[0-9]+$", nullable: true}
+
+  OpenApiSpex.schema(%{
+    type: :object,
+    nullable: false,
+    properties: %{
+      status: %Schema{type: :string, enum: ["pending", "complete"], nullable: false},
+      rule_version: %Schema{type: :string, enum: ["FHS-D/64c12623"], nullable: false},
+      total: @amount,
+      block_reward: @amount,
+      common_miner_reward: @amount,
+      common_rpc_reward: @amount,
+      payouts: %Schema{
+        type: :array,
+        nullable: false,
+        items: %Schema{
+          type: :object,
+          nullable: false,
+          properties: %{
+            address_hash: %Schema{type: :string, pattern: "^0x[0-9a-fA-F]{40}$", nullable: false},
+            category: %Schema{type: :string, enum: ["block", "common_miner", "common_rpc"], nullable: false},
+            reward: %Schema{type: :string, pattern: "^[0-9]+$", nullable: false}
+          },
+          required: [:address_hash, :category, :reward],
+          additionalProperties: false
+        }
+      }
+    },
+    required: [:status, :rule_version, :total, :block_reward, :common_miner_reward, :common_rpc_reward, :payouts],
+    additionalProperties: false
+  })
+end
