+# Modified for ColossusX on 2026-09-21. SPDX-License-Identifier: GPL-3.0-only
+defmodule BlockScoutWeb.API.V2.ColossusXBlockControllerTest do
+  use BlockScoutWeb.ConnCase
+
+  setup do
+    Supervisor.terminate_child(Explorer.Supervisor, Explorer.Chain.Cache.Blocks.child_id())
+    Supervisor.restart_child(Explorer.Supervisor, Explorer.Chain.Cache.Blocks.child_id())
+    previous = Application.fetch_env(:indexer, :fetch_rewards_way)
+    Application.put_env(:indexer, :fetch_rewards_way, "colossusx")
+
+    on_exit(fn ->
+      case previous do
+        {:ok, value} -> Application.put_env(:indexer, :fetch_rewards_way, value)
+        :error -> Application.delete_env(:indexer, :fetch_rewards_way)
+      end
+    end)
+
+    :ok
+  end
+
+  test "block detail exposes pending data without an invented zero", %{conn: conn} do
+    block = insert(:block)
+    result = conn |> get("/api/v2/blocks/#{block.number}") |> json_response(200)
+    assert %{"status" => "pending", "total" => nil, "payouts" => []} = result["colossusx_rewards"]
+  end
+
+  test "detail and list preserve exact totals and distinct payout recipients", %{conn: conn} do
+    block = insert(:block)
+    producer = insert(:address)
+    recipient = insert(:address)
+
+    insert(:reward,
+      block_hash: block.hash,
+      address_hash: producer.hash,
+      address_type: :validator,
+      reward: Decimal.new("100000000000000000000000")
+    )
+
+    insert(:reward,
+      block_hash: block.hash,
+      address_hash: recipient.hash,
+      address_type: :colossusx_rpc,
+      reward: Decimal.new("4200000000001")
+    )
+
+    result = conn |> get("/api/v2/blocks/#{block.number}") |> json_response(200)
+
+    assert %{"status" => "complete", "total" => "100000000004200000000001", "common_rpc_reward" => "4200000000001"} =
+             result["colossusx_rewards"]
+
+    assert %{"address_hash" => to_string(recipient.hash), "category" => "common_rpc", "reward" => "4200000000001"} in result[
+             "colossusx_rewards"
+           ]["payouts"]
+
+    assert Enum.any?(result["rewards"], &(&1["type"] == "Common RPC Reward"))
+
+    list = conn |> get("/api/v2/blocks") |> json_response(200)
+    assert [item] = list["items"]
+    assert item["colossusx_rewards"] == result["colossusx_rewards"]
+  end
+
+  test "cached block list refreshes rewards after backfill without a new block", %{conn: conn} do
+    blocks = insert_list(51, :block)
+    block = Enum.max_by(blocks, & &1.number)
+    pending = conn |> get("/api/v2/blocks") |> json_response(200)
+    assert hd(pending["items"])["colossusx_rewards"]["status"] == "pending"
+
+    producer = insert(:address)
+
+    insert(:reward,
+      block_hash: block.hash,
+      address_hash: producer.hash,
+      address_type: :validator,
+      reward: Decimal.new("100000000000000000000000")
+    )
+
+    complete = conn |> get("/api/v2/blocks") |> json_response(200)
+    item = Enum.find(complete["items"], &(&1["height"] == block.number))
+    assert item["colossusx_rewards"]["status"] == "complete"
+    assert item["colossusx_rewards"]["total"] == "100000000000000000000000"
+  end
+
+  test "verified rewardless block is complete with a zero total", %{conn: conn} do
+    block = insert(:block)
+    producer = insert(:address)
+
+    insert(:reward,
+      block_hash: block.hash,
+      address_hash: producer.hash,
+      address_type: :validator,
+      reward: Decimal.new(0)
+    )
+
+    result = conn |> get("/api/v2/blocks/#{block.number}") |> json_response(200)
+    assert %{"status" => "complete", "total" => "0", "payouts" => []} = result["colossusx_rewards"]
+  end
+end
