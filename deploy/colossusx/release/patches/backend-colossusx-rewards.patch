+    def start_link(owner), do: GenServer.start_link(__MODULE__, owner, name: CoinBalanceCatchup)
+    def init(owner), do: {:ok, owner}
+
+    def handle_call({:buffer, entries, _realtime}, _from, owner) do
+      send(owner, {:balance_entries, entries})
+      {:reply, :ok, owner}
+    end
+  end
