+      |> with_block(block, gas_used: 21_000, cumulative_gas_used: 21_000, status: :ok)
+
+    {rpc_block, header} = fixture(block, [to_string(transaction.hash)])
+    receipt = ColossusXFixture.receipt(rpc_block)
+
+    for _attempt <- 1..2 do
+      expect_block(rpc_block, header, [receipt])
+      assert :ok = BlockReward.run([block.number], arguments)
+      assert_receive {:balance_entries, entries}
+      assert length(entries) == 2
+    end
+
+    rewards = Repo.all(Reward)
+    assert length(rewards) == 2
+    static = Enum.find(rewards, &(&1.address_type == :validator))
+    rpc = Enum.find(rewards, &(&1.address_type == :colossusx_rpc))
+    assert Decimal.equal?(Wei.to(static.reward, :wei), @static_reward)
+    assert Decimal.equal?(Wei.to(rpc.reward, :wei), 4_200_000_000_000)
+    assert to_string(static.address_hash) == header["miner"]
+    assert to_string(rpc.address_hash) == receipt["commonTxRewardRecipient"]
+    assert Repo.all(Block.blocks_without_reward_query()) == []
+  end
+
+  test "verified empty block is marked processed while missing RPC result is retried", %{arguments: arguments} do
+    block = insert(:block, number: 10)
+    {rpc_block, header} = fixture(block, [])
+    expect_block(rpc_block, header, [])
+    assert :ok = BlockReward.run([block.number], arguments)
+    assert [%Reward{address_type: :validator, reward: reward}] = Repo.all(Reward)
+    assert Decimal.equal?(Wei.to(reward, :wei), 0)
+    assert Repo.all(Block.blocks_without_reward_query()) == []
+
+    other_block = insert(:block, number: 11)
+    expect_identity()
+    expect_rpc("eth_getBlockByNumber", ["0xB", false], nil)
+    assert {:retry, [11]} = BlockReward.run([other_block.number], arguments)
+    assert length(Repo.all(Reward)) == 1
+    assert Enum.map(Repo.all(Block.blocks_without_reward_query()), & &1.number) == [11]
+  end
+
+  test "a different canonical hash cannot be imported into the indexed block", %{arguments: arguments} do
+    block = insert(:block, number: 10)
+    {rpc_block, header} = ColossusXFixture.block(10, 0, [])
+    expect_block(rpc_block, header, [])
+    assert {:retry, [10]} = BlockReward.run([block.number], arguments)
+    assert Repo.all(Reward) == []
+    assert Enum.map(Repo.all(Block.blocks_without_reward_query()), & &1.number) == [10]
+  end
+
+  defp fixture(block, transactions) do
+    {rpc_block, header} = ColossusXFixture.block(block.number, 0, transactions)
+    fields = %{"hash" => to_string(block.hash), "parentHash" => to_string(block.parent_hash)}
+    {Map.merge(rpc_block, fields), Map.merge(header, fields)}
+  end
+
+  defp expect_block(block, header, receipts) do
+    expect_identity()
+    expect_rpc("eth_getBlockByNumber", [block["number"], false], block)
+    expect_rpc("eth_getHeaderByHash", [block["hash"]], header)
+
+    if receipts != [] do
+      expect_rpc("eth_getBlockReceipts", [%{blockHash: block["hash"], requireCanonical: true}], receipts)
+    end
+
+    expect_rpc("eth_getHeaderByNumber", [block["number"]], header)
+  end
+
+  defp expect_identity do
+    expect_rpc("eth_chainId", [], "0x9a249f")
+    expect_rpc("eth_getBlockByNumber", ["0x0", false], %{"number" => "0x0", "hash" => ColossusXFixture.genesis_hash()})
+  end
+
+  defp expect_rpc(method, params, result) do
+    expect(EthereumJSONRPC.Mox, :json_rpc, fn %{method: ^method, params: ^params}, _options -> {:ok, result} end)
+  end
+end
