+    Application.put_env(:indexer, :fetch_rewards_way, "colossusx")
+    Application.put_env(:ethereum_jsonrpc, ColossusX, genesis_hash: ColossusXFixture.genesis_hash())
+    Application.put_env(:indexer, Indexer.Fetcher.CoinBalance.Supervisor, disabled?: false)
+    start_supervised!({BalanceSink, self()})
+
+    on_exit(fn ->
