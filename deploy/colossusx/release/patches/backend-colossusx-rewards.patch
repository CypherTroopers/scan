+# Modified for ColossusX on 2026-09-21. SPDX-License-Identifier: GPL-3.0-only
+defmodule BlockScoutWeb.API.RPC.ColossusXBlockViewTest do
+  use ExUnit.Case, async: false
+
+  alias BlockScoutWeb.API.RPC.BlockView
+  alias Explorer.Chain.{Block, Hash, Wei}
+  alias Explorer.Chain.Block.Reward
+
+  @creator "0x1111111111111111111111111111111111111111"
+  @rpc_miner "0x2222222222222222222222222222222222222222"
+
+  setup do
+    previous = Application.fetch_env(:indexer, :fetch_rewards_way)
+    Application.put_env(:indexer, :fetch_rewards_way, "colossusx")
+
+    on_exit(fn ->
+      case previous do
+        {:ok, value} -> Application.put_env(:indexer, :fetch_rewards_way, value)
+        :error -> Application.delete_env(:indexer, :fetch_rewards_way)
+      end
+    end)
+  end
+
+  test "pending custom rewards are not reported as zero" do
+    assert %{"status" => "0", "message" => "Reward data is still being indexed"} =
+             BlockView.render("block_reward.json", %{block: block([])})
+  end
+
+  test "verified empty block is zero" do
+    assert %{"status" => "1", "result" => result} =
+             BlockView.render("block_reward.json", %{block: block([reward(:validator, @creator, 0)])})
+
+    assert result["blockReward"] == "0"
+    assert result["blockMiner"] == @creator
+    assert result["colossusxRewards"].status == "complete"
+  end
+
+  test "reports the true producer and separately paid rewards without Ethereum fees" do
+    rows = [
+      reward(:validator, @creator, 100_000_000_000_000_000_000_000),
+      reward(:colossusx_pow, @rpc_miner, 100_000_000_000_000_000_000_000),
+      reward(:colossusx_rpc, @rpc_miner, 4_200_000_000_001)
+    ]
+
+    assert %{"status" => "1", "result" => result} =
+             BlockView.render("block_reward.json", %{block: block(rows)})
+
+    assert result["blockMiner"] == @creator
+    assert result["blockReward"] == "100000000000000000000000"
+    assert result["colossusxRewards"].total == "200000000004200000000001"
+    assert result["uncleInclusionReward"] == "0"
+    assert result["uncles"] == []
+  end
+
+  test "default networks retain the upstream response shape" do
+    Application.put_env(:indexer, :fetch_rewards_way, "trace_block")
+
+    assert %{"status" => "1", "result" => result} =
+             BlockView.render("block_reward.json", %{block: block([])})
+
+    assert result["blockReward"] == "0"
+    refute Map.has_key?(result, "colossusxRewards")
+  end
+
+  defp block(rewards) do
+    {:ok, miner_hash} = Hash.Address.cast(@rpc_miner)
+    %Block{number: 64, timestamp: ~U[2026-09-21 00:00:00Z], miner_hash: miner_hash, rewards: rewards}
+  end
+
+  defp reward(type, address, amount) do
+    {:ok, address_hash} = Hash.Address.cast(address)
+    %Reward{address_type: type, address_hash: address_hash, reward: %Wei{value: Decimal.new(amount)}}
+  end
+end
--- a/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/colossusx.ex
+++ b/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/colossusx.ex
@@ -0,0 +1,342 @@
+defmodule EthereumJSONRPC.ColossusX do
+  @moduledoc """
+  Reconstructs the ColossusX FHS-D rewards verified against cypher commits
+  70862a71 and 64c12623. All amounts are integer wei, never floating point.
+
+  ColossusX modification, 2026-09-21: use the actual header coinbase, key
+  carrier payout and receipt reward recipient instead of Ethereum PoW rewards.
+  Missing or inconsistent RPC data is an error, never a zero reward.
+  """
+
+  import EthereumJSONRPC, only: [integer_to_quantity: 1, json_rpc: 2, request: 1]
+
+  alias EthereumJSONRPC.FetchedBeneficiaries
+
+  @chain_id 10_101_919
+  @static_reward 100_000_000_000_000_000_000_000
+  @zero_address "0x0000000000000000000000000000000000000000"
+  @hash_fields ~w(hash parentHash keyHash transactionsRoot receiptsRoot stateRoot)
+
+  @doc "Fetches verified rewards sequentially, bounding the RPC load per indexer task."
+  def fetch_beneficiaries(block_numbers, named_arguments) when is_list(block_numbers) do
+    with {:ok, genesis_hash} <- configured_genesis_hash(),
+         :ok <- verify_network(genesis_hash, named_arguments) do
+      result =
+        block_numbers
+        |> Enum.uniq()
+        |> Enum.reduce(%FetchedBeneficiaries{}, fn number, acc ->
+          case fetch_block(number, genesis_hash, named_arguments) do
+            {:ok, params} ->
+              %{acc | params_set: MapSet.union(acc.params_set, MapSet.new(params))}
+
+            {:error, reason} ->
+              error = %{
+                code: -32_603,
+                message: "ColossusX reward verification failed: #{inspect(reason)}",
+                data: %{block_quantity: integer_to_quantity(number)}
+              }
+
+              %{acc | errors: [error | acc.errors]}
+          end
+        end)
+
+      {:ok, result}
+    else
+      {:error, reason} ->
+        {:error, %{code: -32_603, message: "ColossusX network verification failed: #{inspect(reason)}"}}
+    end
+  end
+
+  @doc "Returns retry errors for rewards whose canonical hash changed since block indexing."
+  def consensus_errors(params, hash_by_number) do
+    params
+    |> Enum.reject(&(Map.get(hash_by_number, &1.block_number) == &1.block_hash))
+    |> Enum.map(& &1.block_number)
+    |> Enum.uniq()
+    |> Enum.map(fn number ->
+      %{
+        code: -32_603,
+        message: "ColossusX reward block differs from the indexed canonical hash",
+        data: %{block_quantity: integer_to_quantity(number)}
+      }
+    end)
+  end
+
+  defp configured_genesis_hash do
+    :ethereum_jsonrpc
+    |> Application.get_env(__MODULE__, [])
+    |> Keyword.get(:genesis_hash)
+    |> hash()
+  end
+
+  defp verify_network(genesis_hash, named_arguments) do
+    with {:ok, chain_id} <- rpc("eth_chainId", [], named_arguments),
+         {:ok, @chain_id} <- quantity(chain_id),
+         {:ok, genesis} when is_map(genesis) <- rpc("eth_getBlockByNumber", ["0x0", false], named_arguments),
+         {:ok, 0} <- quantity(genesis["number"]),
+         {:ok, ^genesis_hash} <- hash(genesis["hash"]) do
+      :ok
+    else
+      _ -> {:error, :unexpected_chain_or_genesis}
+    end
+  end
+
+  defp fetch_block(number, genesis_hash, named_arguments) do
+    with {:ok, block} when is_map(block) <-
+           rpc("eth_getBlockByNumber", [integer_to_quantity(number), false], named_arguments),
+         {:ok, ^number} <- quantity(block["number"]),
+         {:ok, block_hash} <- hash(block["hash"]),
+         {:ok, header} when is_map(header) <- rpc("eth_getHeaderByHash", [block_hash], named_arguments),
+         {:ok, context} <- block_context(block, header),
+         {:ok, receipts} <- fetch_receipts(context, named_arguments),
+         {:ok, parent_key, new_key} <- fetch_key_blocks(context, named_arguments),
+         :ok <- verify_canonical(context, named_arguments) do
+      parse_rewards(block, header, receipts, parent_key, new_key, genesis_hash)
+    else
+      {:error, reason} -> {:error, reason}
+      _ -> {:error, :missing_or_mismatched_block}
+    end
+  end
+
+  defp fetch_receipts(%{transactions: []}, _named_arguments), do: {:ok, []}
+
+  defp fetch_receipts(%{hash: block_hash}, named_arguments) do
+    rpc("eth_getBlockReceipts", [%{blockHash: block_hash, requireCanonical: true}], named_arguments)
+  end
+
+  defp fetch_key_blocks(%{number: number, type: 1, key_hash: key_hash}, named_arguments) when number > 0 do
+    with {:ok, parent} when is_map(parent) <- rpc("eth_getKeyBlockByHash", [key_hash], named_arguments),
+         {:ok, parent_number} <- natural(parent["keyBlockNumber"]),
+         {:ok, new_key} when is_map(new_key) <-
+           rpc("eth_getKeyBlockByNumber", [integer_to_quantity(parent_number + 1)], named_arguments) do
+      {:ok, parent, new_key}
+    else
+      {:error, reason} -> {:error, reason}
+      _ -> {:error, :missing_key_block}
+    end
+  end
+
+  defp fetch_key_blocks(_context, _named_arguments), do: {:ok, nil, nil}
+
+  # Recheck after receipt/key-chain reads, including reward-bearing empty carriers.
+  defp verify_canonical(%{number: number, hash: block_hash}, named_arguments) do
+    with {:ok, header} when is_map(header) <-
+           rpc("eth_getHeaderByNumber", [integer_to_quantity(number)], named_arguments),
+         {:ok, ^number} <- quantity(header["number"]),
+         {:ok, ^block_hash} <- hash(header["hash"]) do
+      :ok
+    else
+      _ -> {:error, :canonical_block_changed}
+    end
+  end
+
+  defp rpc(method, params, named_arguments) do
+    case json_rpc(request(%{id: 0, method: method, params: params}), named_arguments) do
+      {:ok, nil} -> {:error, {:missing_rpc_result, method}}
+      {:ok, result} -> {:ok, result}
+      {:error, _reason} -> {:error, {:rpc_failed, method}}
+    end
+  end
+
+  @doc "Pure validation and conversion of exact block, header, receipt and key-block RPC results."
+  def parse_rewards(block, header, receipts, parent_key, new_key, genesis_hash) do
+    with {:ok, genesis_hash} <- hash(genesis_hash),
+         {:ok, context} <- block_context(block, header),
+         :ok <- check_genesis(context, genesis_hash),
+         {:ok, receipt_rewards} <- receipt_rewards(receipts, context, genesis_hash),
+         {:ok, pow_rewards} <- pow_rewards(parent_key, new_key, context) do
+      amount =
+        if context.number > 0 and (context.type == 1 or context.transactions != []),
+          do: @static_reward,
+          else: 0
+
+      # A verified zero validator row marks empty blocks as processed for backfill.
+      static = beneficiary(context, context.miner, :validator, amount)
+      {:ok, [static | pow_rewards ++ receipt_rewards]}
+    end
+  end
+
+  defp block_context(block, header) when is_map(block) and is_map(header) do
+    with {:ok, number} <- quantity(block["number"]),
+         {:ok, ^number} <- quantity(header["number"]),
+         type when type in [0, 1, 2] <- block["blockType"],
+         ^type <- header["blockType"],
+         {:ok, block_hash} <- hash(block["hash"]),
+         {:ok, key_hash} <- hash(header["keyHash"]),
+         {:ok, miner} <- address(header["miner"]),
+         {:ok, gas_used} <- quantity(header["gasUsed"]),
+         {:ok, ^gas_used} <- quantity(block["gasUsed"]),
+         [] <- block["uncles"],
+         transactions when is_list(transactions) <- block["transactions"],
+         true <- valid_transactions?(transactions),
+         true <- type != 1 or transactions == [],
+         true <- transactions != [] or gas_used == 0,
+         true <- Enum.all?(@hash_fields, &equal_hash_field?(block, header, &1)) do
+      {:ok,
+       %{
+         number: number,
+         hash: block_hash,
+         key_hash: key_hash,
+         type: type,
+         miner: miner,
+         gas_used: gas_used,
+         transactions: Enum.map(transactions, &String.downcase/1)
+       }}
+    else
+      _ -> {:error, :invalid_block_or_header}
+    end
+  end
+
+  defp block_context(_, _), do: {:error, :invalid_block_or_header}
+
+  defp valid_transactions?(transactions) do
+    Enum.all?(transactions, &match?({:ok, _}, hash(&1))) and
+      MapSet.size(MapSet.new(Enum.map(transactions, &String.downcase/1))) == length(transactions)
+  end
+
+  defp equal_hash_field?(block, header, field) do
+    case {hash(block[field]), hash(header[field])} do
+      {{:ok, value}, {:ok, value}} -> true
+      _ -> false
+    end
+  end
+
+  defp check_genesis(%{number: 0, hash: genesis_hash, transactions: []}, genesis_hash), do: :ok
+  defp check_genesis(%{number: number}, _genesis_hash) when number > 0, do: :ok
+  defp check_genesis(_context, _genesis_hash), do: {:error, :invalid_genesis}
+
+  defp receipt_rewards(receipts, context, genesis_hash) when is_list(receipts) do
+    if length(receipts) == length(context.transactions) do
+      receipts
+      |> Enum.reduce_while({:ok, %{}, MapSet.new(), 0}, fn receipt, {:ok, rewards, indices, gas} ->
+        case receipt_reward(receipt, context, genesis_hash) do
+          {:ok, index, recipient, reward, gas_used} ->
+            if MapSet.member?(indices, index) do
+              {:halt, {:error, :duplicate_receipt}}
+            else
+              totals = Map.update(rewards, recipient, reward, &(&1 + reward))
+              {:cont, {:ok, totals, MapSet.put(indices, index), gas + gas_used}}
+            end
+
+          {:error, _} = error ->
+            {:halt, error}
+        end
+      end)
+      |> receipt_totals(context)
+    else
+      {:error, :receipt_count_mismatch}
+    end
+  end
+
+  defp receipt_rewards(_, _context, _genesis_hash), do: {:error, :missing_receipts}
+
+  defp receipt_totals({:ok, rewards, _indices, gas}, %{gas_used: gas} = context) do
+    params =
+      rewards
+      |> Enum.filter(fn {_address, amount} -> amount > 0 end)
+      |> Enum.map(fn {recipient, amount} -> beneficiary(context, recipient, :colossusx_rpc, amount) end)
+
+    {:ok, params}
+  end
+
+  defp receipt_totals({:error, _} = error, _context), do: error
+  defp receipt_totals(_result, _context), do: {:error, :receipt_gas_mismatch}
+
+  defp receipt_reward(receipt, context, genesis_hash) when is_map(receipt) do
+    with {:ok, block_hash} <- hash(receipt["blockHash"]),
+         true <- block_hash == context.hash,
+         {:ok, number} <- quantity(receipt["blockNumber"]),
+         true <- number == context.number,
+         {:ok, index} <- quantity(receipt["transactionIndex"]),
+         {:ok, tx_hash} <- hash(receipt["transactionHash"]),
+         true <- Enum.at(context.transactions, index) == tx_hash,
+         {:ok, @chain_id} <- quantity(receipt["commonTxAdmissionChainId"]),
+         {:ok, ^genesis_hash} <- hash(receipt["commonTxAdmissionGenesisHash"]),
+         {:ok, approver} <- address(receipt["commonTxApprover"]),
+         true <- approver != @zero_address,
+         {:ok, recipient} <- address(receipt["commonTxRewardRecipient"]),
+         true <- recipient != @zero_address,
+         true <- recipient != approver,
+         {:ok, gas_used} <- quantity(receipt["gasUsed"]),
+         {:ok, gas_price} <- quantity(receipt["effectiveGasPrice"]),
+         {:ok, reward} <- quantity(receipt["commonTxApproverReward"]),
+         {:ok, burn} <- quantity(receipt["commonTxBurn"]),
+         true <- reward == div(gas_used * gas_price, 5),
+         true <- burn == gas_used * gas_price - reward do
+      {:ok, index, recipient, reward, gas_used}
+    else
+      _ -> {:error, :invalid_receipt_reward}
+    end
+  end
+
+  defp receipt_reward(_, _context, _genesis_hash), do: {:error, :invalid_receipt_reward}
+
+  defp pow_rewards(parent_key, new_key, %{number: number, type: 1} = context) when number > 0 do
+    with true <- is_map(parent_key) and is_map(new_key),
+         {:ok, parent_hash} <- hash(parent_key["hash"]),
+         true <- parent_hash == context.key_hash,
+         {:ok, parent_number} <- natural(parent_key["keyBlockNumber"]),
+         true <- parent_key["blockType"] in [1, 2, 3, 4] or (parent_number == 0 and parent_key["blockType"] == 9),
+         {:ok, _new_hash} <- hash(new_key["hash"]),
+         true <- new_key["blockType"] in [1, 2, 3, 4],
+         {:ok, ^parent_hash} <- hash(new_key["parentHash"]),
+         {:ok, new_number} <- natural(new_key["keyBlockNumber"]),
+         true <- new_number == parent_number + 1,
+         {:ok, tx_number} <- natural(new_key["TxBlockNumber"]),
+         true <- tx_number == number - 1,
+         {:ok, recipient} <- pow_recipient(new_key["outAddress"]) do
+      params = if recipient, do: [beneficiary(context, recipient, :colossusx_pow, @static_reward)], else: []
+      {:ok, params}
+    else
+      _ -> {:error, :invalid_key_block_link}
+    end
+  end
+
+  defp pow_rewards(nil, nil, _context), do: {:ok, []}
+  defp pow_rewards(_, _, _context), do: {:error, :unexpected_key_block}
+
+  defp pow_recipient(value) when is_binary(value) do
+    case String.replace_prefix(value, "*", "") do
+      "" -> {:ok, nil}
+      "0x" <> _ = address -> address(address)
+      address -> address("0x" <> address)
+    end
+  end
+
+  defp pow_recipient(_), do: {:error, :invalid_pow_recipient}
+
+  defp beneficiary(context, recipient, type, amount) do
+    %{
+      address_hash: recipient,
+      address_type: type,
+      block_hash: context.hash,
+      block_number: context.number,
+      reward: integer_to_quantity(amount)
+    }
+  end
+
+  defp natural(value) when is_integer(value) and value >= 0, do: {:ok, value}
+  defp natural(_), do: {:error, :invalid_integer}
+
+  defp quantity(value) when is_binary(value) do
+    if Regex.match?(~r/^0x(?:0|[1-9a-fA-F][0-9a-fA-F]*)$/, value) do
+      {number, ""} = value |> String.slice(2..-1//1) |> Integer.parse(16)
+      {:ok, number}
+    else
+      {:error, :invalid_quantity}
+    end
+  end
+
+  defp quantity(_), do: {:error, :invalid_quantity}
+
+  defp hash(value), do: hexadecimal(value, 64)
+  defp address(value), do: hexadecimal(value, 40)
+
+  defp hexadecimal(value, size) when is_binary(value) do
+    if byte_size(value) == size + 2 and Regex.match?(~r/^0x[0-9a-fA-F]+$/, value),
+      do: {:ok, String.downcase(value)},
+      else: {:error, :invalid_hexadecimal}
+  end
+
+  defp hexadecimal(_, _), do: {:error, :invalid_hexadecimal}
+end
--- a/apps/ethereum_jsonrpc/test/ethereum_jsonrpc/colossusx_test.exs
+++ b/apps/ethereum_jsonrpc/test/ethereum_jsonrpc/colossusx_test.exs
