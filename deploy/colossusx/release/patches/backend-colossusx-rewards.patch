+defmodule EthereumJSONRPC.ColossusXTest do
+  use EthereumJSONRPC.Case, async: false
+
+  import Mox
+  import EthereumJSONRPC, only: [integer_to_quantity: 1, quantity_to_integer: 1]
+
+  alias EthereumJSONRPC.{ColossusX, ColossusXFixture, FetchedBeneficiaries}
+
+  @static_reward 100_000_000_000_000_000_000_000
+
+  setup :verify_on_exit!
+
+  setup do
+    previous = Application.get_env(:ethereum_jsonrpc, ColossusX)
+    Application.put_env(:ethereum_jsonrpc, ColossusX, genesis_hash: ColossusXFixture.genesis_hash())
+
+    on_exit(fn ->
+      if previous,
+        do: Application.put_env(:ethereum_jsonrpc, ColossusX, previous),
+        else: Application.delete_env(:ethereum_jsonrpc, ColossusX)
+    end)
+
+    {:ok, arguments: [transport: EthereumJSONRPC.Mox, transport_options: [], variant: EthereumJSONRPC.Geth]}
+  end
+
+  test "uses header creator and exact receipt recipient, not block miner or approver" do
+    {block, header} = ColossusXFixture.block()
+    receipt = ColossusXFixture.receipt(block)
+    assert {:ok, rewards} = parse(block, header, [receipt])
+    assert [static] = Enum.filter(rewards, &(&1.address_type == :validator))
+    assert static.address_hash == header["miner"]
+    assert static.address_hash != block["miner"]
+    assert quantity_to_integer(static.reward) == @static_reward
+    assert [rpc] = Enum.filter(rewards, &(&1.address_type == :colossusx_rpc))
+    assert rpc.address_hash == receipt["commonTxRewardRecipient"]
+    assert rpc.address_hash != receipt["commonTxApprover"]
+    assert quantity_to_integer(rpc.reward) == 4_200_000_000_000
+  end
+
+  test "verified genesis and empty FastTx/SlowTx blocks have zero processed markers" do
+    for {number, type} <- [{0, 0}, {10, 0}, {10, 2}] do
+      {block, header} = ColossusXFixture.block(number, type, [])
+      assert {:ok, [%{address_type: :validator, reward: "0x0"}]} = parse(block, header, [])
+    end
+  end
+
+  test "nonempty SlowTx receives the static reward" do
+    {block, header} = ColossusXFixture.block(10, 2)
+    assert {:ok, rewards} = parse(block, header, [ColossusXFixture.receipt(block)])
+    assert quantity_to_integer(hd(rewards).reward) == @static_reward
+  end
+
+  test "key carrier pays static and common miner even without transactions" do
+    {block, header} = ColossusXFixture.block(10, 1, [])
+    {parent, key} = ColossusXFixture.key_blocks(block)
+    assert {:ok, [static, pow]} = parse(block, header, [], parent, key)
+    assert static.address_type == :validator
+    assert pow.address_type == :colossusx_pow
+    assert pow.address_hash == ColossusXFixture.address("d")
+    assert quantity_to_integer(static.reward) == @static_reward
+    assert quantity_to_integer(pow.reward) == @static_reward
+  end
+
+  test "empty outAddress is a verified absence of common-miner payout" do
+    {block, header} = ColossusXFixture.block(10, 1, [])
+    {parent, key} = ColossusXFixture.key_blocks(block, "")
+    assert {:ok, [%{address_type: :validator}]} = parse(block, header, [], parent, key)
+  end
+
+  test "aggregates repeated receipt recipients and preserves multiple recipients" do
+    {block, header} = ColossusXFixture.block(10, 0, Enum.map(~w(a b c), &ColossusXFixture.hash/1))
+    receipts = for index <- 0..2, do: ColossusXFixture.receipt(block, index)
+    receipts = List.update_at(receipts, 2, &Map.put(&1, "commonTxRewardRecipient", ColossusXFixture.address("e")))
+    assert {:ok, rewards} = parse(block, header, Enum.reverse(receipts))
+
+    rpc =
+      rewards
+      |> Enum.filter(&(&1.address_type == :colossusx_rpc))
+      |> Map.new(&{&1.address_hash, quantity_to_integer(&1.reward)})
+
+    assert rpc[ColossusXFixture.address("b")] == 8_400_000_000_000
+    assert rpc[ColossusXFixture.address("e")] == 4_200_000_000_000
+  end
+
+  test "fee division rounds down in wei and the burn keeps the remainder" do
+    {block, header} = ColossusXFixture.block()
+    block = Map.put(block, "gasUsed", "0x7")
+    header = Map.put(header, "gasUsed", "0x7")
+
+    receipt =
+      ColossusXFixture.receipt(block)
+      |> Map.merge(%{
+        "gasUsed" => "0x7",
+        "effectiveGasPrice" => "0x3",
+        "commonTxApproverReward" => "0x4",
+        "commonTxBurn" => "0x11"
+      })
+
+    assert {:ok, rewards} = parse(block, header, [receipt])
+    assert Enum.find(rewards, &(&1.address_type == :colossusx_rpc)).reward == "0x4"
+    assert {:error, _} = parse(block, header, [Map.put(receipt, "commonTxBurn", "0x10")])
+  end
+
+  test "missing, duplicate, mismatched and partial receipts cannot become zero rewards" do
+    {block, header} = ColossusXFixture.block()
+    receipt = ColossusXFixture.receipt(block)
+    assert {:error, _} = parse(block, header, [])
+    assert {:error, _} = parse(block, header, nil)
+    assert {:error, _} = parse(block, header, [receipt, receipt])
+
+    for key <-
+          ~w(blockHash blockNumber transactionHash transactionIndex commonTxRewardRecipient commonTxApproverReward commonTxBurn commonTxAdmissionGenesisHash commonTxAdmissionChainId effectiveGasPrice) do
+      assert {:error, _} = parse(block, header, [Map.delete(receipt, key)])
+    end
+
+    assert {:error, _} = parse(block, header, [Map.put(receipt, "blockHash", ColossusXFixture.hash("f"))])
+    assert {:error, _} = parse(block, header, [Map.put(receipt, "commonTxApproverReward", "0x0")])
+
+    assert {:error, _} =
+             parse(block, header, [Map.put(receipt, "commonTxRewardRecipient", receipt["commonTxApprover"])])
+  end
+
+  test "duplicate receipt indices and a mismatched gas total are rejected" do
+    {block, header} = ColossusXFixture.block(10, 0, Enum.map(~w(a b), &ColossusXFixture.hash/1))
+    receipt = ColossusXFixture.receipt(block)
+    assert {:error, :duplicate_receipt} = parse(block, header, [receipt, receipt])
+    receipts = [receipt, ColossusXFixture.receipt(block, 1)]
+    assert {:error, _} = parse(Map.put(block, "gasUsed", "0x1"), Map.put(header, "gasUsed", "0x1"), receipts)
+  end
+
+  test "rejects mismatched headers, unexpected types, uncles and missing genesis" do
+    {block, header} = ColossusXFixture.block(10, 0, [])
+    assert {:error, _} = parse(block, Map.put(header, "hash", ColossusXFixture.hash("f")), [])
+    assert {:error, _} = parse(block, Map.put(header, "number", "0xB"), [])
+    assert {:error, _} = parse(Map.put(block, "blockType", 3), Map.put(header, "blockType", 3), [])
+    assert {:error, _} = parse(Map.put(block, "uncles", [ColossusXFixture.hash("f")]), header, [])
+    assert {:error, _} = ColossusX.parse_rewards(block, header, [], nil, nil, nil)
+  end
+
+  test "key payout requires exact parent, sequential key number and carrier height" do
+    {block, header} = ColossusXFixture.block(10, 1, [])
+    {parent, key} = ColossusXFixture.key_blocks(block)
+    assert {:error, _} = parse(block, header, [], nil, nil)
+
+    for {field, value} <- [
+          {"parentHash", ColossusXFixture.hash("f")},
+          {"keyBlockNumber", 7},
+          {"TxBlockNumber", 10},
+          {"outAddress", "**abcd"},
+          {"blockType", 8}
+        ] do
+      assert {:error, _} = parse(block, header, [], parent, Map.put(key, field, value))
+    end
+  end
+
+  test "fetch checks network identity and uses canonical receipts", %{arguments: arguments} do
+    {block, header} = ColossusXFixture.block()
+    expect_identity()
+    expect_rpc("eth_getBlockByNumber", ["0xA", false], block)
+    expect_rpc("eth_getHeaderByHash", [block["hash"]], header)
+
+    expect_rpc("eth_getBlockReceipts", [%{blockHash: block["hash"], requireCanonical: true}], [
+      ColossusXFixture.receipt(block)
+    ])
+
+    expect_rpc("eth_getHeaderByNumber", ["0xA"], header)
+    assert {:ok, %FetchedBeneficiaries{errors: [], params_set: params}} = ColossusX.fetch_beneficiaries([10], arguments)
+    assert MapSet.size(params) == 2
+  end
+
+  test "wrong chain or genesis rejects the entire batch", %{arguments: arguments} do
+    expect_rpc("eth_chainId", [], "0x1")
+    assert {:error, _} = ColossusX.fetch_beneficiaries([10], arguments)
+    expect_rpc("eth_chainId", [], "0x9a249f")
+    expect_rpc("eth_getBlockByNumber", ["0x0", false], %{"number" => "0x0", "hash" => ColossusXFixture.hash("f")})
+    assert {:error, _} = ColossusX.fetch_beneficiaries([10], arguments)
+  end
+
+  test "RPC null creates a retry error and never a zero processed marker", %{arguments: arguments} do
+    expect_identity()
+    expect_rpc("eth_getBlockByNumber", ["0xA", false], nil)
+
+    assert {:ok, %FetchedBeneficiaries{params_set: params, errors: [error]}} =
+             ColossusX.fetch_beneficiaries([10], arguments)
+
+    assert MapSet.size(params) == 0
+    assert error.data.block_quantity == "0xA"
+  end
+
+  test "receipt RPC errors leave the block pending", %{arguments: arguments} do
+    {block, header} = ColossusXFixture.block()
+    expect_identity()
+    expect_rpc("eth_getBlockByNumber", ["0xA", false], block)
+    expect_rpc("eth_getHeaderByHash", [block["hash"]], header)
+
+    expect(EthereumJSONRPC.Mox, :json_rpc, fn %{method: "eth_getBlockReceipts"}, _ ->
+      {:error, %{code: -32_601, message: "Method unavailable"}}
+    end)
+
+    assert {:ok, %FetchedBeneficiaries{params_set: params, errors: [error]}} =
+             ColossusX.fetch_beneficiaries([10], arguments)
+
+    assert MapSet.size(params) == 0
+    assert error.data.block_quantity == "0xA"
+  end
+
+  test "reorg after empty carrier key reads rejects all payouts", %{arguments: arguments} do
+    {block, header} = ColossusXFixture.block(10, 1, [])
+    {parent, key} = ColossusXFixture.key_blocks(block)
+    expect_identity()
+    expect_rpc("eth_getBlockByNumber", ["0xA", false], block)
+    expect_rpc("eth_getHeaderByHash", [block["hash"]], header)
+    expect_rpc("eth_getKeyBlockByHash", [header["keyHash"]], parent)
+    expect_rpc("eth_getKeyBlockByNumber", ["0x6"], key)
+    expect_rpc("eth_getHeaderByNumber", ["0xA"], Map.put(header, "hash", ColossusXFixture.hash("f")))
+
+    assert {:ok, %FetchedBeneficiaries{params_set: params, errors: [_error]}} =
+             ColossusX.fetch_beneficiaries([10], arguments)
+
+    assert MapSet.size(params) == 0
+  end
+
+  test "canonical-hash mismatches create one retry per block" do
+    params = [
+      %{block_number: 10, block_hash: "old"},
+      %{block_number: 10, block_hash: "old"},
+      %{block_number: 11, block_hash: "current"}
+    ]
+
+    assert [%{data: %{block_quantity: "0xA"}}] =
+             ColossusX.consensus_errors(params, %{10 => "new", 11 => "current"})
+  end
+
+  defp parse(block, header, receipts, parent \\ nil, key \\ nil) do
+    ColossusX.parse_rewards(block, header, receipts, parent, key, ColossusXFixture.genesis_hash())
+  end
+
