# Copy to .env and set private values before starting Docker Compose.
# Use URL-safe passwords, for example: openssl rand -hex 32
DB_PASSWORD=
STATS_DB_PASSWORD=
# Generate independently, for example: openssl rand -hex 64
SECRET_KEY_BASE=

# Optional external Blockscout database; empty uses DB_PASSWORD with the db service.
# This URL is also the default for stats and user-ops-indexer.
DATABASE_URL=
# Optional service-specific database URL overrides.
STATS__DB_URL=
STATS__BLOCKSCOUT_DB_URL=
USER_OPS_INDEXER__DATABASE__CONNECT__URL=
